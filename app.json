{
  "expo": {
    "name": "MedHome",
    "slug": "MedHome",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icons/mh-icon.png",
    "scheme": "medhome",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/icons/mh-adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "/assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDFDFD",
          "image": "./src/assets/icons/mh-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
